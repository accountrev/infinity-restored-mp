function RibbonToyBox:StartSparkMode()
  self:RemoveScreen()
  local modeSelectHandle = self:GetModeSelect()
  self:CallScreenFunction(modeSelectHandle, "DoInput", "")
  if self.EditMode == self.EditMode_Normal then
    print("toggle - spark\n")
    self.EditMode = self.EditMode_Spark
    Place_SetEditMode(self.InstanceData.playerNum, "RumpusEditorModeSpark")
    if self.curGhostObject ~= 0 then
      Place_IncrementObjectsUsedCount(self.curGhostName, 1)
      Place_DeletePickedObject(self.InstanceData.playerNum, self.curGhostObject)
    end
    self.curGhostObject = 0
    self.shouldPlaceFirstObject = false
  else
    print("toggle - object\n")
    self.EditMode = self.EditMode_Normal
    self:UpdateInUseCounts()
    self.curGhostObject = 0
    if self:CurrentItemIsPlaceable() == true then
      Place_StartPlaceMode(self.InstanceData.playerNum)
      self:PlaceNewGhost()
    end
    Place_SetEditMode(self.InstanceData.playerNum, "RumpusEditorModeSpark")
  end
  self:CallFlashFunction("_root.RefreshButtonLegend")
end

